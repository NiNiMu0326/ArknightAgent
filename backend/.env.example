# ===== 必需 =====
# SiliconFlow API Key — 向量嵌入 + 重排（https://siliconflow.cn）
SILICONFLOW_API_KEY=sk-your-key-here

# JWT 签名密钥，生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-jwt-secret-here

# ===== 可选 =====
# DeepSeek API Key（https://platform.deepseek.com）
DEEPSEEK_API_KEY_2=sk-your-deepseek-key-here

# Tavily API Key — 网络搜索（不填则使用 DuckDuckGo 兜底）
TAVILY_API_KEY=tvly-your-tavily-key-here

# 后端端口，默认 8100
PORT=8100

# PRTS MCP（外部 MCP 工具，可选依赖；false 时完全跳过连接）
PRTS_MCP_ENABLED=true
PRTS_MCP_COMMAND=prts-mcp
PRTS_MCP_CONNECT_TIMEOUT=10 # 秒
PRTS_MCP_CALL_TIMEOUT=60 # 秒

# ===== 可观测性（可选） =====
# LangFuse — LLM 可观测性（https://langfuse.com）
# 不设置则禁用追踪
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
